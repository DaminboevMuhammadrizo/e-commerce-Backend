generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER
  BUYER
  ADMIN
  SUPERADMIN
}

enum ListingType {
  ForSale
  ForRent
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  role      UserRole @default(BUYER)
  password  String
  avatar    String?
  createdAt DateTime @default(now())

  accommodations Accomodation[]
  likes          Like[]
  ratings        Rating[]
  contacts       Contact[]
}

model Accomodation {
  id             Int         @id @default(autoincrement())
  img            Json
  isActive       Boolean
  title          String
  beds           Int
  baths          Int
  garage         Int
  sq_ft          Int
  price          Float
  discount       Float?
  build_year     Int
  description    String
  documents      Json?
  map_url        String?
  latitude       Float
  longitude      Float
  country        String
  extra_features Json?
  listing_type   ListingType
  introeVideo    String?
  user_id        Int
  category_id    Int

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [category_id], references: [id], onDelete: Cascade)
  likes    Like[]
  ratings  Rating[]
  contacts Contact[]
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  img           String
  icon_img      String
  accomodations Accomodation[]
}

model Contact {
  id               Int      @id @default(autoincrement())
  date             DateTime
  time             String
  name             String
  phone            String
  email            String
  message          String
  user_id          Int
  accommodation_id Int

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accommodation Accomodation @relation(fields: [accommodation_id], references: [id], onDelete: Cascade)
}

model Rating {
  id               Int   @id @default(autoincrement())
  clean            Float
  location         Float
  communicate      Float
  user_id          Int
  accommodation_id Int

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accommodation Accomodation @relation(fields: [accommodation_id], references: [id], onDelete: Cascade)
}

model Like {
  id               Int     @id @default(autoincrement())
  like             Boolean
  user_id          Int
  accommodation_id Int

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  accommodation Accomodation @relation(fields: [accommodation_id], references: [id], onDelete: Cascade)
}
